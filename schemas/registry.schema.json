{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/SmileyTatsu/smileychat-plugins/main/schemas/registry.schema.json",
    "title": "SmileyChat Plugin Registry",
    "type": "object",
    "additionalProperties": false,
    "required": ["version", "plugins"],
    "properties": {
        "version": {
            "const": 1
        },
        "plugins": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/plugin"
            }
        }
    },
    "$defs": {
        "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url"],
            "properties": {
                "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://.*\\.zip([?#].*)?$"
                }
            }
        },
        "plugin": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "name",
                "version",
                "category",
                "status",
                "artifact"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^(?!\\.\\.?$)[A-Za-z0-9._-]+$"
                },
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "description": {
                    "type": "string",
                    "minLength": 1
                },
                "version": {
                    "type": "string",
                    "minLength": 1
                },
                "author": {
                    "type": "string",
                    "minLength": 1
                },
                "category": {
                    "enum": [
                        "interface",
                        "input-output",
                        "automation",
                        "connections",
                        "tools",
                        "memory-lore",
                        "other"
                    ]
                },
                "status": {
                    "enum": ["official", "verified"]
                },
                "repository": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://"
                },
                "permissions": {
                    "type": "array",
                    "maxItems": 32,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                    }
                },
                "apiVersion": {
                    "type": "integer",
                    "minimum": 1
                },
                "minAppVersion": {
                    "type": "string",
                    "pattern": "^v?\\d+(\\.\\d+){0,2}(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
                },
                "artifact": {
                    "$ref": "#/$defs/artifact"
                }
            }
        }
    }
}
